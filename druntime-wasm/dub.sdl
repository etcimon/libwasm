name "druntime-wasm"
description "DRuntime and Standard Library for WebAssembly (1.36 FILE-CMP pin). Default EH-capable tree is ../runtime-v1.43.0."
version "1.36.0" # Pin for LDC 1.36.0; libwasm default config uses runtime-v1.43.0

# Builds only in arch=wasm32-unknown-wasi
targetType "sourceLibrary"
targetArch "wasm32-unknown-wasi"
versions "CRuntime_DRUNTIME_WASM"

sourcePaths "core" "rt" "ldc" "std"
sourceFiles "object.d"
