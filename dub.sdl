name "libwasm"
version "0.11.1"
description "A framework for writing webassembly single page applications"
authors "Sebastiaan Koppe" "Etienne Cimon"
copyright "Copyright © 2018-2023, Sebastiaan Koppe, Etienne Cimon"
license "MIT"
dependency "memutils-wasm" path="./memutils-wasm"
dependency "fast-wasm" path="./fast-wasm"
dependency "diet-wasm" path="./diet-wasm"
dependency "optional-wasm" path="./optional-wasm"
#target "library"
subPackage "webidl"
dflags "-dip1000"

toolchainRequirements ldc=">=1.36.0"
versions "CRuntime_LIBWASM"
buildRequirements "allowWarnings" # required for ldc 1.16
sourcePaths "source"
# Default: LDC 1.43 + carried runtime-v1.43.0 (wasm EH + exception-using Phobos).
# Pin 1.36 and carry 1.42 stay as named configs.
configuration "library" {
    dependency "druntime-wasm-143" path="./runtime-v1.43.0"
    subConfiguration "memutils-wasm" "ldc-master"
    subConfiguration "fast-wasm" "ldc-master"
    subConfiguration "optional-wasm" "ldc-master"
    dflags "-fvisibility=hidden" "-fno-moduleinfo" "-mattr=+exception-handling" "--wasm-enable-eh" "-link-internally" "-defaultlib=" "--foptimize-nothrow=false"
    lflags "-allow-undefined" "--export-table" "--export=domEvent" "--export=allocString" "--export=dumpApp" "--export=loadApp" "-export=__heap_base"
}

# LDC 1.36.0 + vendored pin druntime-wasm (pre-EH abort-on-throw)
configuration "ldc-1.36" {
    dependency "druntime-wasm" path="./druntime-wasm"
    subConfiguration "memutils-wasm" "ldc-1.36"
    subConfiguration "fast-wasm" "ldc-1.36"
    subConfiguration "optional-wasm" "ldc-1.36"
    dflags "-fvisibility=hidden" "-fno-moduleinfo" "-mattr=+exception-handling"
    lflags "-allow-undefined" "--export-table" "--export=domEvent" "--export=allocString" "--export=dumpApp" "--export=loadApp" "-export=__heap_base"
}

# G6LC_G6B: the "ldc-1.42" configuration is removed on this branch, not merely
# unused. It declared `dependency ... path="./runtime-v1.42.0"`, but that
# directory is not present in v0.11.1, and DUB resolves dependencies across
# *every* configuration — so the dangling path made even `--config=g6lc-bios`
# fail with "Failed to load path based dependency druntime-wasm". The BIOS cell
# is pinned to LDC 1.43 (browser-ui/toolchains/ldc.lock.json), so there is
# nothing here to keep working.

# Alias of library: LDC master / 1.43 (riscv-compilers/ldc2) + runtime-v1.43.0
configuration "ldc-master" {
    dependency "druntime-wasm-143" path="./runtime-v1.43.0"
    subConfiguration "memutils-wasm" "ldc-master"
    subConfiguration "fast-wasm" "ldc-master"
    subConfiguration "optional-wasm" "ldc-master"
    dflags "-fvisibility=hidden" "-fno-moduleinfo" "-mattr=+exception-handling" "--wasm-enable-eh" "-link-internally" "-defaultlib=" "--foptimize-nothrow=false"
    lflags "-allow-undefined" "--export-table" "--export=domEvent" "--export=allocString" "--export=dumpApp" "--export=loadApp" "-export=__heap_base"
}

# G6LC_G6B: the g6lc_bios BIOS browser cell. Same LDC 1.43 + runtime-v1.43.0
# toolchain as ldc-master, and deliberately a SEPARATE configuration rather than
# a mutation of it, so this fork stays rebasable onto upstream.
#
# Two differences, both forced by the kernel host rather than preference:
#   versions "G6LC_G6B"  substitutes libwasm.g6b_kernel for the default
#                        extern(C) import block, so the cell imports exactly the
#                        set architecture/LIBWASM-ABI.md documents. Declaring an
#                        import the host does not provide fails instantiation.
#   --export=_start      the BIOS host calls _start; it never dispatches
#                        domEvent, so exporting that instead would leave the
#                        cell with no reachable entry point.
configuration "g6lc-bios" {
    dependency "druntime-wasm-143" path="./runtime-v1.43.0"
    subConfiguration "memutils-wasm" "ldc-master"
    subConfiguration "fast-wasm" "ldc-master"
    subConfiguration "optional-wasm" "ldc-master"
    versions "G6LC_G6B"
    dflags "-fvisibility=hidden" "-fno-moduleinfo" "-mattr=+exception-handling" "--wasm-enable-eh" "-link-internally" "-defaultlib=" "--foptimize-nothrow=false"
    lflags "-allow-undefined" "--export-table" "--export=_start" "--export=allocString" "--export=dumpApp" "--export=loadApp" "-export=__heap_base"
}

configuration "unittest" {
    targetName "ut"
    targetType "executable"
    subConfiguration "memutils-wasm" "unittest"
    subConfiguration "fast-wasm" "unittest"
    subConfiguration "diet-wasm" "unittest"
    subConfiguration "optional-wasm" "unittest"
    dependency "unit-threaded" version="*"
    sourcePaths "source" "tests/ut"
    importPaths "source" "tests/ut"
    mainSourceFile "tests/ut/test_main.d"
}